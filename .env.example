# ---------------------------------------------------------------------------
# Database (Neon/Postgres)
# ---------------------------------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/devpulse?sslmode=require"
# Direct connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/devpulse?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (GitHub OAuth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Create a GitHub OAuth app at:
# https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
# Optional. Email/password signup and login work without GitHub OAuth.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# GitHub API — server only. Never prefix this with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# A fine-grained read-only token is recommended. For local demos, a classic
# token with public read access is enough.
GITHUB_TOKEN="github_pat_replace_me"

# ---------------------------------------------------------------------------
# Site URL (used by metadata and OG images)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional Upstash Redis. When omitted, DevPulse automatically falls back to
# Postgres for both caching and rate limiting.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
